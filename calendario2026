"},{"n":"Curso: Interiorismo Comercial y Mobiliario de Exhibición","f":"Arquitectura y Diseño","s":"Curso","d":"28/10/2026"},{"n":"Curso de Mezcla Musical Avanzada: técnica, criterio y creatividad","f":"Artes","s":"Curso","d":"13/07/2026"},{"n":"Curso Producción y Síntesis de Audio en Ableton Live","f":"Artes","s":"Curso","d":"23/07/2026"},{"n":"Curso Ley de Responsabilidad Parental y Pago Efectivo de Alimentos (Ley 21.484)","f":"Ciencias Jurídicas y Sociales","s":"Curso","d":"05/08/2026"},{"n":"Curso en Registro Nacional de Deudores de Pensiones de Alimentos","f":"Ciencias Jurídicas y Sociales","s":"Curso","d":"10/08/2026"},{"n":"Curso Arte Contemporáneo y Bienales Internacionales","f":"Artes","s":"Curso","d":"05/10/2026"}];

const MONTH_NAMES = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

const FAC_COLORS = {
  'Ciencias Jurídicas y Sociales': '#6366F1',
  'Artes': '#EC4899',
  'Comunicaciones': '#F97316',
  'Psicología': '#14B8A6',
  'Negocios y Tecnología': '#3B82F6',
  'Diversidad, Género e Inclusión': '#8B5CF6',
  'Arquitectura y Diseño': '#EF4444'
};

// Parse date
function parseDate(d) {
  if (!d) return null;
  const [day, month, year] = d.split('/');
  return { day: parseInt(day), month: parseInt(month), year: parseInt(year), raw: d };
}

function formatDate(d) {
  if (!d) return 'Por confirmar';
  const parsed = parseDate(d);
  return `${parsed.day} de ${MONTH_NAMES[parsed.month].toLowerCase()}`;
}

// State
let activeTipo = null;
let activeFac = null;
let activeMonth = null;
let searchTerm = '';

// Get unique values
const tipos = [...new Set(DATA.filter(p => p.s).map(p => p.s))].sort();
const facultades = [...new Set(DATA.filter(p => p.f).map(p => p.f))].sort();
const availableMonths = [...new Set(DATA.filter(p => p.d).map(p => parseInt(p.d.split('/')[1])))].sort((a,b) => a - b);

// Build filters
function buildFilters() {
  const tipoWrap = document.getElementById('tipo-filters');
  const allBtn = document.createElement('button');
  allBtn.className = 'filter-btn active';
  allBtn.textContent = 'Todos';
  allBtn.onclick = () => { activeTipo = null; updateFilters(); render(); };
  tipoWrap.appendChild(allBtn);
  
  tipos.forEach(t => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.dataset.tipo = t;
    btn.textContent = t;
    btn.onclick = () => { activeTipo = activeTipo === t ? null : t; updateFilters(); render(); };
    tipoWrap.appendChild(btn);
  });

  const facWrap = document.getElementById('fac-filters');
  const allFacBtn = document.createElement('button');
  allFacBtn.className = 'filter-btn active';
  allFacBtn.textContent = 'Todas';
  allFacBtn.onclick = () => { activeFac = null; updateFilters(); render(); };
  facWrap.appendChild(allFacBtn);

  facultades.forEach(f => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.dataset.fac = f;
    btn.textContent = f;
    btn.onclick = () => { activeFac = activeFac === f ? null : f; updateFilters(); render(); };
    facWrap.appendChild(btn);
  });

  // Month filters
  const monthWrap = document.getElementById('month-filters');
  const allMonthBtn = document.createElement('button');
  allMonthBtn.className = 'filter-btn active';
  allMonthBtn.textContent = 'Todos';
  allMonthBtn.onclick = () => { activeMonth = null; updateFilters(); render(); };
  monthWrap.appendChild(allMonthBtn);

  availableMonths.forEach(m => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.dataset.month = m;
    btn.textContent = MONTH_NAMES[m];
    btn.onclick = () => { activeMonth = activeMonth === m ? null : m; updateFilters(); render(); };
    monthWrap.appendChild(btn);
  });
}

function updateFilters() {
  // Tipo buttons
  document.querySelectorAll('#tipo-filters .filter-btn').forEach(btn => {
    const t = btn.dataset.tipo;
    if (!t) {
      btn.className = activeTipo === null ? 'filter-btn active' : 'filter-btn';
    } else {
      btn.className = activeTipo === t ? 'filter-btn active-tipo' : 'filter-btn';
    }
  });
  // Fac buttons
  document.querySelectorAll('#fac-filters .filter-btn').forEach(btn => {
    const f = btn.dataset.fac;
    if (!f) {
      btn.className = activeFac === null ? 'filter-btn active' : 'filter-btn';
    } else {
      btn.className = activeFac === f ? 'filter-btn active' : 'filter-btn';
    }
  });
  // Month buttons
  document.querySelectorAll('#month-filters .filter-btn').forEach(btn => {
    const m = btn.dataset.month;
    if (!m) {
      btn.className = activeMonth === null ? 'filter-btn active' : 'filter-btn';
    } else {
      btn.className = activeMonth === parseInt(m) ? 'filter-btn active' : 'filter-btn';
    }
  });
}

function getFiltered() {
  return DATA.filter(p => {
    if (activeTipo && p.s !== activeTipo) return false;
    if (activeFac && p.f !== activeFac) return false;
    if (activeMonth) {
      if (!p.d) return false;
      const m = parseInt(p.d.split('/')[1]);
      if (m !== activeMonth) return false;
    }
    if (searchTerm && !p.n.toLowerCase().includes(searchTerm)) return false;
    return true;
  });
}

function renderCard(p) {
  const cls = p.s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const facColor = FAC_COLORS[p.f] || '#666';
  return `
    <div class="program-card">
      <div class="card-accent ${cls}"></div>
      <div class="card-body">
        <div class="card-meta">
          <span class="card-tipo ${cls}">${p.s}</span>
          <span class="card-date">${formatDate(p.d)}</span>
        </div>
        <div class="card-name">${p.n}</div>
        <div class="card-fac">
          <span class="fac-dot" style="background:${facColor}"></span>
          ${p.f || 'Sin facultad'}
        </div>
      </div>
    </div>
  `;
}

function render() {
  const filtered = getFiltered();
  const cal = document.getElementById('calendar');
  
  // Group by month
  const withDate = filtered.filter(p => p.d);
  const withoutDate = filtered.filter(p => !p.d);
  
  // Sort by date
  withDate.sort((a, b) => {
    const da = parseDate(a.d), db = parseDate(b.d);
    return (da.year * 10000 + da.month * 100 + da.day) - (db.year * 10000 + db.month * 100 + db.day);
  });

  const months = {};
  withDate.forEach(p => {
    const parsed = parseDate(p.d);
    const key = parsed.month;
    if (!months[key]) months[key] = [];
    months[key].push(p);
  });

  let html = '';
  const sortedMonths = Object.keys(months).map(Number).sort((a, b) => a - b);
  
  sortedMonths.forEach((m, idx) => {
    const progs = months[m];
    html += `
      <div class="month-section" style="animation-delay: ${idx * 0.05}s">
        <div class="month-header">
          <span class="month-name">${MONTH_NAMES[m]}</span>
          <span class="month-year">2026</span>
          <span class="month-count">${progs.length} programa${progs.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="programs-grid">
          ${progs.map(renderCard).join('')}
        </div>
      </div>
    `;
  });

  if (withoutDate.length > 0) {
    html += `
      <div class="no-date-section">
        <div class="no-date-header">Fecha por confirmar</div>
        <div class="programs-grid">
          ${withoutDate.map(renderCard).join('')}
        </div>
      </div>
    `;
  }

  if (filtered.length === 0) {
    html = `
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p>No se encontraron programas con los filtros seleccionados.</p>
      </div>
    `;
  }

  cal.innerHTML = html;

  // Update stats
  const diplomados = filtered.filter(p => p.s === 'Diplomado').length;
  const cursos = filtered.filter(p => p.s === 'Curso').length;
  const talleres = filtered.filter(p => p.s === 'Taller').length;
  const pasantias = filtered.filter(p => p.s === 'Pasantía').length;
  
  let statsHtml = `<div class="stat"><div class="stat-num">${filtered.length}</div><div class="stat-label">Programas</div></div>`;
  if (diplomados) statsHtml += `<div class="stat"><div class="stat-num" style="color:var(--diplomado)">${diplomados}</div><div class="stat-label">Diplomados</div></div>`;
  if (cursos) statsHtml += `<div class="stat"><div class="stat-num" style="color:var(--curso)">${cursos}</div><div class="stat-label">Cursos</div></div>`;
  if (talleres) statsHtml += `<div class="stat"><div class="stat-num" style="color:var(--taller)">${talleres}</div><div class="stat-label">Talleres</div></div>`;
  if (pasantias) statsHtml += `<div class="stat"><div class="stat-num" style="color:var(--pasantia)">${pasantias}</div><div class="stat-label">Pasantías</div></div>`;
  document.getElementById('stats-bar').innerHTML = statsHtml;
}

// Search
document.getElementById('search').addEventListener('input', (e) => {
  searchTerm = e.target.value.toLowerCase().trim();
  render();
});

// Scroll top button
window.addEventListener('scroll', () => {
  document.getElementById('scrollTop').classList.toggle('visible', window.scrollY > 400);
});

// Init
buildFilters();
render();
</script>
</body>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calendarización 2026 · MÁS Educación Continua UNIACC</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0B0E14;
    --surface: #12161F;
    --surface-hover: #181D29;
    --border: rgba(255,255,255,0.06);
    --text: #E8EAF0;
    --text-dim: #8B90A0;
    --text-muted: #5A5F70;
    --accent: #4E9FFF;
    --accent-glow: rgba(78,159,255,0.15);
    
    --diplomado: #4E9FFF;
    --curso: #10B981;
    --taller: #F59E0B;
    --pasantia: #A855F7;
    
    --fac-juridicas: #6366F1;
    --fac-artes: #EC4899;
    --fac-comunicaciones: #F97316;
    --fac-psicologia: #14B8A6;
    --fac-negocios: #3B82F6;
    --fac-diversidad: #8B5CF6;
    --fac-arquitectura: #EF4444;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    padding: 60px 24px 48px;
    text-align: center;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -120px; left: 50%; transform: translateX(-50%);
    width: 800px; height: 500px;
    background: radial-gradient(ellipse, rgba(78,159,255,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid rgba(78,159,255,0.2);
    padding: 6px 18px;
    border-radius: 100px;
    margin-bottom: 24px;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .hero h1 span {
    background: linear-gradient(135deg, #4E9FFF, #A78BFA);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero p {
    color: var(--text-dim);
    font-size: 15px;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── STATS BAR ── */
  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    padding: 0 24px 32px;
  }
  .stat {
    text-align: center;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
  }
  .stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* ── FILTERS ── */
  .filters-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 24px;
  }
  .filter-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    align-items: center;
  }
  .filter-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    min-width: 70px;
    padding-top: 2px;
  }
  .filter-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .filter-btn:hover {
    border-color: rgba(255,255,255,0.15);
    color: var(--text);
    background: var(--surface);
  }
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .filter-btn.active-tipo[data-tipo="Diplomado"] { background: var(--diplomado); border-color: var(--diplomado); color: #fff; }
  .filter-btn.active-tipo[data-tipo="Curso"] { background: var(--curso); border-color: var(--curso); color: #fff; }
  .filter-btn.active-tipo[data-tipo="Taller"] { background: var(--taller); border-color: var(--taller); color: #000; }
  .filter-btn.active-tipo[data-tipo="Pasantía"] { background: var(--pasantia); border-color: var(--pasantia); color: #fff; }

  /* Search */
  .search-wrap {
    position: relative;
    max-width: 400px;
    margin-bottom: 16px;
  }
  .search-wrap input {
    width: 100%;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    padding: 10px 16px 10px 40px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
  }
  .search-wrap input:focus {
    border-color: rgba(78,159,255,0.4);
  }
  .search-wrap input::placeholder { color: var(--text-muted); }
  .search-wrap svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  /* ── MONTH SECTIONS ── */
  .calendar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .month-section {
    margin-bottom: 48px;
    animation: fadeUp 0.5s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .month-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .month-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .month-year {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 400;
  }
  .month-count {
    margin-left: auto;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--surface);
    padding: 4px 12px;
    border-radius: 100px;
    border: 1px solid var(--border);
  }

  /* ── PROGRAM CARDS ── */
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 12px;
  }
  @media (max-width: 480px) {
    .programs-grid { grid-template-columns: 1fr; }
  }

  .program-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    transition: all 0.25s ease;
    cursor: default;
    position: relative;
    overflow: hidden;
  }
  .program-card:hover {
    background: var(--surface-hover);
    border-color: rgba(255,255,255,0.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  .card-accent {
    width: 4px;
    min-height: 100%;
    border-radius: 4px;
    flex-shrink: 0;
    align-self: stretch;
  }
  .card-accent.diplomado { background: var(--diplomado); }
  .card-accent.curso { background: var(--curso); }
  .card-accent.taller { background: var(--taller); }
  .card-accent.pasantia { background: var(--pasantia); }

  .card-body { flex: 1; min-width: 0; }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .card-tipo {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .card-tipo.diplomado { background: rgba(78,159,255,0.15); color: var(--diplomado); }
  .card-tipo.curso { background: rgba(16,185,129,0.15); color: var(--curso); }
  .card-tipo.taller { background: rgba(245,158,11,0.15); color: var(--taller); }
  .card-tipo.pasantia { background: rgba(168,85,247,0.15); color: var(--pasantia); }

  .card-date {
    font-size: 12px;
    color: var(--text-dim);
    font-weight: 500;
  }

  .card-name {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 6px;
    color: var(--text);
  }

  .card-fac {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .fac-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── SIN FECHA ── */
  .no-date-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px dashed rgba(255,255,255,0.08);
  }
  .no-date-header {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  /* ── EMPTY STATE ── */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
  }
  .empty-state svg {
    margin-bottom: 16px;
    opacity: 0.4;
  }
  .empty-state p {
    font-size: 15px;
  }

  /* ── FOOTER ── */
  .footer {
    text-align: center;
    padding: 32px 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 12px;
  }
  .footer a {
    color: var(--accent);
    text-decoration: none;
  }

  /* ── SCROLL TOP ── */
  .scroll-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(78,159,255,0.4);
  }
  .scroll-top.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
</head>
